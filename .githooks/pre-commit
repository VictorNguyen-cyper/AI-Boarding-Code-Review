#!/bin/sh
# Pre-commit hook (section 4a of automated-scanning.md, plus the data file checks).
# Enable once with: git config core.hooksPath .githooks

ROOT="$(git rev-parse --show-toplevel)"

gitleaks protect --staged --redact --verbose || {
  echo "Possible secret leak detected. Commit blocked."
  exit 1
}

if git diff --cached --name-only | grep -qxE 'log.csv|findings.csv|boundary.csv|effort.csv'; then
  # Check exactly what is about to be committed, not the working copies.
  TMP="$(mktemp -d)"
  for f in log.csv findings.csv boundary.csv effort.csv; do
    git show ":$f" > "$TMP/$f" 2>/dev/null || {
      rm -f "$TMP/$f"
      [ ! -e "$ROOT/$f" ] || cp "$ROOT/$f" "$TMP/$f"
    }
  done
  python3 "$ROOT/scripts/check-log.py" "$TMP/log.csv" &&
    python3 "$ROOT/scripts/check-classification.py" \
      "$TMP/findings.csv" "$TMP/boundary.csv" "$TMP/log.csv" "$TMP/effort.csv"
  rc=$?
  rm -rf "$TMP"
  [ $rc -eq 0 ] || {
    echo "Data files are not valid. Commit blocked."
    exit 1
  }
fi
