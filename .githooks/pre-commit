#!/bin/sh
# Pre-commit hook (section 4a of automated-scanning.md, plus the log check).
# Enable once with: git config core.hooksPath .githooks

ROOT="$(git rev-parse --show-toplevel)"

gitleaks protect --staged --redact --verbose || {
  echo "Possible secret leak detected. Commit blocked."
  exit 1
}

if git diff --cached --name-only | grep -qx 'log.csv'; then
  # Check exactly what is about to be committed, not the working copy.
  TMP="$(mktemp)"
  git show :log.csv > "$TMP"
  python3 "$ROOT/scripts/check-log.py" "$TMP" || {
    rm -f "$TMP"
    echo "log.csv is not valid. Commit blocked."
    exit 1
  }
  rm -f "$TMP"
fi
