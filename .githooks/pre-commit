#!/bin/sh
# Pre-commit hook (section 4a of automated-scanning.md, plus the data file checks).
# Enable once with: git config core.hooksPath .githooks

ROOT="$(git rev-parse --show-toplevel)"

gitleaks protect --staged --redact --verbose || {
  echo "Possible secret leak detected. Commit blocked."
  exit 1
}

if git diff --cached --name-only | grep -qxE 'log.csv|features.csv|findings.csv'; then
  # Check exactly what is about to be committed, not the working copies.
  TMP="$(mktemp -d)"
  for f in log.csv features.csv findings.csv; do
    git show ":$f" > "$TMP/$f" 2>/dev/null || cp "$ROOT/$f" "$TMP/$f"
  done
  python3 "$ROOT/scripts/check-log.py" "$TMP/log.csv" &&
    python3 "$ROOT/scripts/qa.py" check --log "$TMP/log.csv" \
      --features "$TMP/features.csv" --findings "$TMP/findings.csv"
  rc=$?
  rm -rf "$TMP"
  [ $rc -eq 0 ] || {
    echo "Data files are not valid. Commit blocked."
    exit 1
  }
fi
